{
  "benchmark": "OmniBrowse-Text",
  "dataset": {
    "path": "../examples/omnibrowse_text.csv",
    "version": "v1.0"
  },
  "model": {
    "adapter": "openai_compatible",
    "display_name": "my-model",
    "model_id": "replace-me",
    "supports_video": false,
    "supports_audio": false,
    "base_url": "https://api.example.com/v1",
    "api_key": "${MODEL_API_KEY}",
    "timeout_seconds": 300,
    "parameters": {
      "temperature": 0,
      "max_tokens": 4096
    }
  },
  "search": {
    "api_key": "${SERPER_API_KEY}",
    "gl": "us",
    "hl": "en",
    "num_results": 10,
    "timeout_seconds": 30,
    "max_page_chars": 20000,
    "download_images": true,
    "image_download_count": 3,
    "max_image_bytes": 8000000
  },
  "agent": {
    "max_steps": 20,
    "max_text_searches": 10,
    "max_image_searches": 5,
    "max_page_opens": 15,
    "max_media_bytes": 100000000,
    "timeout_seconds": 600
  },
  "output_root": "../results"
}

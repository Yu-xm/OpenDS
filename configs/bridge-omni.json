{
  "benchmark": "OmniBrowse",
  "dataset": {
    "path": "../examples/omnibrowse.csv",
    "version": "v1.0"
  },
  "model": {
    "adapter": "bridge",
    "display_name": "official-or-self-hosted-model",
    "model_id": "replace-me",
    "supports_video": true,
    "supports_audio": true,
    "endpoint": "http://127.0.0.1:9000/generate",
    "headers": {
      "Authorization": "Bearer ${MODEL_API_KEY}"
    },
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_base_seconds": 2,
    "retry_max_seconds": 30,
    "parameters": {
      "temperature": 0,
      "max_output_tokens": 4096
    }
  },
  "search": {
    "api_key": "${SERPER_API_KEY}",
    "gl": "us",
    "hl": "en",
    "num_results": 10,
    "timeout_seconds": 30,
    "max_page_chars": 20000,
    "download_images": true,
    "image_download_count": 3
  },
  "agent": {
    "max_steps": 20,
    "max_text_searches": 10,
    "max_image_searches": 5,
    "max_page_opens": 15,
    "max_media_bytes": 100000000,
    "timeout_seconds": 360,
    "finalization_grace_seconds": 60,
    "final_answer_reserve_steps": 1,
    "max_empty_answer_retries": 1,
    "max_identical_tool_calls": 1,
    "max_similar_searches": 3,
    "similar_search_threshold": 0.82,
    "max_searches_without_open": 8,
    "max_blocked_tool_steps": 2,
    "keep_recent_tool_observations": 4,
    "history_search_results": 2,
    "history_page_chars": 2000,
    "keep_recent_reasoning_messages": 2
  },
  "output_root": "../results"
}

{
  "benchmark": "OmniBrowse-Text",
  "dataset": {
    "path": "../examples/omnibrowse_text.csv",
    "version": "demo"
  },
  "model": {
    "adapter": "mock",
    "display_name": "mock-model",
    "model_id": "mock"
  },
  "search": {
    "api_key": "unused-by-mock",
    "gl": "us",
    "hl": "en",
    "num_results": 10,
    "download_images": true
  },
  "agent": {
    "max_steps": 20,
    "max_text_searches": 10,
    "max_image_searches": 5,
    "max_page_opens": 15,
    "max_media_bytes": 100000000,
    "timeout_seconds": 360,
    "finalization_grace_seconds": 60,
    "final_answer_reserve_steps": 1
  },
  "output_root": "../results"
}
